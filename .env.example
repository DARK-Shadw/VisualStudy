# LLM API Configuration
# Choose your provider: gemini or openrouter
LLM_PROVIDER=gemini

# Google Gemini API Key (get from https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter API Key (alternative, get from https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Feature Flags
ENABLE_3D_VISUALIZATIONS=true
ENABLE_COLLABORATIVE_LEARNING=false

# Database
DATABASE_URL=sqlite:///./backend/storage/courses.db
